# ScrapeAPI Environment Configuration
# Copy this file to .env and fill in values

# Application
APP_NAME=ScrapeAPI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/scrapeapi
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_STARTER=10000
RATE_LIMIT_PRO=50000

# Proxy Configuration
PROXY_ENABLED=false
# PROXY_DATACENTER_URL=http://user:pass@proxy:port
# PROXY_RESIDENTIAL_URL=http://user:pass@proxy:port

# Scraper
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Sentry (Error Tracking)
# SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_TRACES_SAMPLE_RATE=0.1

# API Keys
API_KEY_HEADER=X-API-Key
API_KEY_LENGTH=32
